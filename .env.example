# Токен бота из @BotFather (команда /newbot)
TELEGRAM_BOT_TOKEN=

# Ключ Gemini API из aistudio.google.com (нужен только для генерации картинок)
GEMINI_API_KEY=

# Ссылки на CSV-версии вкладок Google Таблицы (см. README.md, шаг "Google Таблица")
FABRICS_CSV_URL=
PRODUCTS_CSV_URL=

# Необязательно: название компании — печатается сверху в PDF-документе
COMPANY_NAME=

# Необязательно: модель картинок (по умолчанию gemini-2.5-flash-image = Nano Banana)
NANO_BANANA_MODEL=
